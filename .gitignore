node_modules/
.artifacts/
bin/
obj/
__pycache__/
dist/

# generated by scripts/run-samples.mjs; uploaded as a CI artifact, not committed
results/

# generated by scripts/generate-samples-coverage.mjs; uploaded as a CI artifact, not committed
coverage/

# generated by scripts/lib/sample-bundles.mjs -- scratch staging area for
# integrity-verified honua-sdk-js sample bundle files before build-gallery.mjs
# copies them into site/sdk/<id>/app/ (honua-io/honua-samples#11); never committed
.sample-bundles-staging/

# generated by scripts/build-gallery.mjs (honua-io/honua-samples#3) -- everything
# under site/ is build output rebuilt fresh by pages.yml on every deploy, EXCEPT
# the two static files GitHub Pages itself needs, which stay committed.
site/*
!site/CNAME
!site/.nojekyll
