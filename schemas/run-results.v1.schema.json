{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://honua.io/schemas/run-results.v1.schema.json",
  "title": "Honua Sample Run Results v1",
  "description": "Shape of results/run-results.v1.json, written by scripts/run-samples.mjs and uploaded as a CI artifact. honua-evidence joins these envelopes by capability key (honua-io/honua-evidence#1/#3).",
  "type": "object",
  "required": ["schema", "generatedAt", "serverVersion", "baseUrl", "results"],
  "properties": {
    "schema": { "const": "run-results.v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "serverVersion": {
      "type": "string",
      "description": "Best-effort; \"unknown\" when no authenticated version endpoint was reachable."
    },
    "baseUrl": { "type": "string" },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "capabilities", "outcome", "durationMs", "serverVersion"],
        "properties": {
          "id": { "type": "string" },
          "capabilities": { "type": "array", "items": { "type": "string" } },
          "outcome": { "type": "string", "enum": ["pass", "fail"] },
          "durationMs": { "type": "number" },
          "serverVersion": { "type": "string" },
          "error": { "type": "string", "description": "Present only when outcome is \"fail\"." }
        }
      }
    }
  }
}
