<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <HonuaServerCheckout Condition="'$(HONUA_SERVER_CHECKOUT)' != ''">$(HONUA_SERVER_CHECKOUT)</HonuaServerCheckout>
    <HonuaServerCheckout Condition="'$(HonuaServerCheckout)' == ''">$(MSBuildThisFileDirectory)../../artifacts/server-sdk</HonuaServerCheckout>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(HonuaServerCheckout)/src/Honua.Plugins.Abstractions/Honua.Plugins.Abstractions.csproj" />
  </ItemGroup>
</Project>
